          value_type: TEXT
          inventory_link: SERIALNO_B
          preprocessing:
            - type: DISCARD_UNCHANGED_HEARTBEAT
              parameters:
                - 6h
          tags:
            - tag: component
              value: inventory
          triggers:
            - uuid: b07234a3b9914d3ab48e9f4818cd27ec
              expression: 'last(/Wiseway UPS/system.systemSerialNumber,#1)<>last(/Wiseway UPS/system.systemSerialNumber,#2) and length(last(/Wiseway UPS/system.systemSerialNumber))>0'
